<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="268.0" prefWidth="394.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="clienteescritorio.FXMLModalEstatusController">
   <children>
      <Label layoutX="130.0" layoutY="25.0" text="Seleccione uno">
         <font><Font name="System Bold" size="18.0" /></font>
      </Label>
      <GridPane hgap="20.0" layoutX="50.0" layoutY="70.0" vgap="15.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="140.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="140.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Button mnemonicParsing="false" onAction="#clicTransito" prefWidth="140.0" text="En Tránsito" />
            <Button mnemonicParsing="false" onAction="#clicDetenido" prefWidth="140.0" text="Detenido" GridPane.columnIndex="1" />
            <Button mnemonicParsing="false" onAction="#clicEntregado" prefWidth="140.0" text="Entregado" GridPane.rowIndex="1" />
            <Button mnemonicParsing="false" onAction="#clicCancelado" prefWidth="140.0" text="Cancelado" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         </children>
      </GridPane>
      <TextArea fx:id="taComentario" layoutX="50.0" layoutY="159.0" prefHeight="41.0" prefWidth="300.0" promptText="Comentario (obligatorio para Detenido/Cancelado)" />
      <Button layoutX="119.0" layoutY="205.0" mnemonicParsing="false" onAction="#clicActualizar" prefHeight="30.0" prefWidth="163.0" text="Actualizar Estatus" />
   </children>
</AnchorPane>
