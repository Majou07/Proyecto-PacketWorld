<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="700.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="clienteescritorio.FXMLEnviosController">
   <children>
      <Label layoutX="300.0" layoutY="20.0" text="ENVÍOS">
         <font><Font size="20.0" /></font>
      </Label>
      <TextField fx:id="tfBusquedaEnvio" layoutX="30.0" layoutY="60.0" prefWidth="300.0" promptText="Buscar por Número de Guía" />
      <Button layoutX="650.0" layoutY="60.0" mnemonicParsing="false" onAction="#btnRegistrarEnvio" text="Registrar Envío" />
      
      <TableView fx:id="tvEnvios" layoutX="30.0" layoutY="100.0" prefHeight="250.0" prefWidth="600.0">
        <columns>
          <TableColumn fx:id="colGuia" prefWidth="100.0" text="No. Guía" />
          <TableColumn fx:id="colCliente" prefWidth="100.0" text="Cliente" />
          <TableColumn fx:id="colOrigen" prefWidth="80.0" text="Origen" />
          <TableColumn fx:id="colDestino" prefWidth="120.0" text="Destino" />
          <TableColumn fx:id="colConductor" prefWidth="100.0" text="Conductor" />
          <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
        </columns>
      </TableView>
      
      <VBox layoutX="650.0" layoutY="100.0" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#btnActualizarEnvio" prefWidth="120.0" text="Actualizar" />
            <Button mnemonicParsing="false" onAction="#btnEliminarEnvio" prefWidth="120.0" text="Eliminar" />
         </children>
      </VBox>
      
      <Button layoutX="200.0" layoutY="360.0" mnemonicParsing="false" onAction="#btnHistorial" text="Historial Estatus" />
      <Button layoutX="350.0" layoutY="360.0" mnemonicParsing="false" onAction="#btnAsignarConductor" text="Asignar Conductor" />

      <Separator layoutX="30.0" layoutY="390.0" prefWidth="740.0" />

      <Label layoutX="600.0" layoutY="20.0" text="PAQUETES">
         <font><Font size="20.0" /></font>
      </Label>
      
      <Button layoutX="650.0" layoutY="410.0" mnemonicParsing="false" onAction="#btnAgregarPaquete" text="Agregar Paquete" />
      
      <TableView fx:id="tvPaquetes" layoutX="30.0" layoutY="410.0" prefHeight="250.0" prefWidth="600.0">
         <columns>
            <TableColumn fx:id="colDescripcion" prefWidth="200.0" text="Descripción" />
            <TableColumn fx:id="colPeso" prefWidth="80.0" text="Peso" />
            <TableColumn fx:id="colDimensiones" prefWidth="150.0" text="Dimensiones" />
            <TableColumn fx:id="colEnvioPertence" prefWidth="150.0" text="Guía Envío" />
         </columns>
      </TableView>
      
      <VBox layoutX="650.0" layoutY="450.0" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#btnEditarPaquete" prefWidth="120.0" text="Editar" />
            <Button mnemonicParsing="false" onAction="#btnEliminarPaquete" prefWidth="120.0" text="Eliminar" />
         </children>
      </VBox>
   </children>
</AnchorPane>