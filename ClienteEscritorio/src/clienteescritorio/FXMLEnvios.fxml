<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="651.0" prefWidth="915.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="clienteescritorio.FXMLEnviosController">
   <children>
      <Label layoutX="29.0" layoutY="22.0" text="ENVÍOS">
         <font><Font size="20.0" /></font>
      </Label>
      <TextField fx:id="tfBusquedaEnvio" layoutX="30.0" layoutY="60.0" prefWidth="300.0" promptText="Buscar por Número de Guía" />
      <Button layoutX="733.0" layoutY="93.0" mnemonicParsing="false" onAction="#btnRegistrarEnvio" text="Registrar Envío" />
      
      <TableView fx:id="tvEnvios" layoutX="30.0" layoutY="100.0" prefHeight="250.0" prefWidth="680.0">
        <columns>
          <TableColumn fx:id="colGuia" prefWidth="100.0" text="No. Guía" />
          <TableColumn fx:id="colCliente" prefWidth="100.0" text="Cliente" />
          <TableColumn fx:id="colOrigen" prefWidth="80.0" text="Origen" />
          <TableColumn fx:id="colDestino" prefWidth="120.0" text="Destino" />
          <TableColumn fx:id="colConductor" prefWidth="100.0" text="Conductor" />
          <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
          <TableColumn fx:id="colCosto" prefWidth="80.0" text="Costo $" />
        </columns>
      </TableView>
      
      <VBox layoutX="650.0" layoutY="100.0" spacing="10.0" />
      
      <Button layoutX="31.0" layoutY="359.0" mnemonicParsing="false" onAction="#btnHistorial" text="Historial Estatus" />
      <Button layoutX="181.0" layoutY="359.0" mnemonicParsing="false" onAction="#btnAsignarConductor" text="Asignar Conductor" />

      <Label layoutX="520.0" layoutY="383.0" text="PAQUETES">
         <font><Font size="20.0" /></font>
      </Label>
      
      <Button layoutX="636.0" layoutY="427.0" mnemonicParsing="false" onAction="#btnAgregarPaquete" text="Agregar Paquete" />
      
      <TableView fx:id="tvPaquetes" layoutX="16.0" layoutY="427.0" prefHeight="250.0" prefWidth="600.0">
         <columns>
            <TableColumn fx:id="colDescripcion" prefWidth="200.0" text="Descripción" />
            <TableColumn fx:id="colPeso" prefWidth="80.0" text="Peso" />
            <TableColumn fx:id="colDimensiones" prefWidth="150.0" text="Dimensiones" />
            <TableColumn fx:id="colEnvioPertence" prefWidth="150.0" text="Guía Envío" />
         </columns>
      </TableView>
      
      <VBox layoutX="635.0" layoutY="479.0" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#btnEditarPaquete" prefWidth="120.0" text="Editar" />
            <Button mnemonicParsing="false" onAction="#btnEliminarPaquete" prefWidth="120.0" text="Eliminar" />
         </children>
      </VBox>
      <Button layoutX="734.0" layoutY="206.0" mnemonicParsing="false" onAction="#btnEliminarEnvio" prefWidth="120.0" text="Eliminar" />
      <Button layoutX="734.0" layoutY="149.0" mnemonicParsing="false" onAction="#btnActualizarEnvio" prefWidth="120.0" text="Actualizar" />
      <Button layoutX="734.0" layoutY="267.0" mnemonicParsing="false" onAction="#btnRecalcularTodosCostos" text="Recalcular Costos" />
   </children>
</AnchorPane>
