<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="clienteescritorio.FXMLFormularioUnidadController">
   <children>
      <Label fx:id="lbTitulo" layoutX="30.0" layoutY="20.0" text="Registro de Unidad">
         <font><Font size="20.0" /></font>
      </Label>
      
      <TextField fx:id="tfMarca" layoutX="27.0" layoutY="86.0" prefWidth="200.0" />
      <Label layoutX="30.0" layoutY="60.0" text="Marca" />
      
      <TextField fx:id="tfModelo" layoutX="249.0" layoutY="85.0" prefWidth="200.0" />
      <Label layoutX="250.0" layoutY="60.0" text="Modelo" />
      
      <TextField fx:id="tfAnio" layoutX="472.0" layoutY="82.0" prefWidth="100.0" />
      <Label layoutX="470.0" layoutY="60.0" text="Año" />
      
      <TextField fx:id="tfVIN" layoutX="29.0" layoutY="192.0" prefHeight="11.0" prefWidth="169.0" />
      <Label layoutX="29.0" layoutY="166.0" text="VIN" />
      
      <ComboBox fx:id="cbTipoUnidad" layoutX="237.0" layoutY="192.0" prefWidth="200.0" />
      <Label layoutX="231.0" layoutY="155.0" text="Tipo de Unidad" />
      
      <TextField fx:id="tfNII" layoutX="462.0" layoutY="189.0" prefWidth="100.0" promptText="Auto" />
      <Label layoutX="465.0" layoutY="156.0" text="NII" />
      
      <Button layoutX="350.0" layoutY="300.0" mnemonicParsing="false" onAction="#btnCancelar" text="Cancelar" />
      <Button layoutX="450.0" layoutY="300.0" mnemonicParsing="false" onAction="#btnGuardar" text="Registrar" />
   </children>
</AnchorPane>
