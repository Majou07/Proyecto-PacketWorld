<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="clienteescritorio.FXMLFormularioEnvioController">
   <children>
      <Label layoutX="35.0" layoutY="20.0" text="Registro de Envío">
         <font><Font name="System Bold" size="24.0" /></font>
      </Label>

      <GridPane hgap="20.0" layoutX="35.0" layoutY="70.0" vgap="15.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="210.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="210.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="210.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label text="Cliente *" />
                  <ComboBox fx:id="cbCliente" prefWidth="210.0" />
                  <Label fx:id="lbErrorCliente" text="Requerido" textFill="RED" visible="false" />
               </children>
            </VBox>
            <VBox spacing="2.0" GridPane.rowIndex="1">
               <children>
                  <Label text="Nombre Destinatario *" />
                  <TextField fx:id="tfNombreDest" />
                  <Label fx:id="lbErrorNombre" text="Solo caracteres de a-z" textFill="RED" visible="false" />
               </children>
            </VBox>
            <VBox spacing="2.0" GridPane.rowIndex="2">
               <children>
                  <Label text="Calle Destino *" />
                  <TextField fx:id="tfCalle" />
                  <Label fx:id="lbErrorCalle" text="Requerido" textFill="RED" visible="false" />
               </children>
            </VBox>
            <VBox spacing="2.0" GridPane.rowIndex="3">
               <children>
                  <Label text="Código Postal (CP) *" />
                  <TextField fx:id="tfCP" promptText="5 dígitos" />
                  <Label fx:id="lbErrorCP" text="CP no válido" textFill="RED" visible="false" />
               </children>
            </VBox>

            <VBox spacing="2.0" GridPane.columnIndex="1">
               <children>
                  <Label text="Sucursal Origen *" />
                  <ComboBox fx:id="cbSucursal" prefWidth="210.0" />
                  <Label fx:id="lbErrorSucursal" text="Requerido" textFill="RED" visible="false" />
               </children>
            </VBox>
            <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <Label text="Apellido Paterno *" />
                  <TextField fx:id="tfApPaternoDest" />
                  <Label fx:id="lbErrorApPaterno" text="Solo caracteres de a-z" textFill="RED" visible="false" />
               </children>
            </VBox>
            <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <children>
                  <Label text="Colonia *" />
                  <TextField fx:id="tfColonia" />
                  <Label fx:id="lbErrorColonia" text="Requerido" textFill="RED" visible="false" />
               </children>
            </VBox>
            <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
               <children>
                  <Label text="Ciudad" />
                  <TextField fx:id="tfCiudad" editable="false" style="-fx-background-color: #eee;" />
               </children>
            </VBox>

            <VBox spacing="2.0" GridPane.columnIndex="2">
               <children>
                  <Label text="Número ext/int *" />
                  <TextField fx:id="tfNumero" />
                  <Label fx:id="lbErrorNumero" text="Solo números permitidos" textFill="RED" visible="false" />
               </children>
            </VBox>
            <VBox spacing="2.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
               <children>
                  <Label text="Apellido Materno" />
                  <TextField fx:id="tfApMaternoDest" />
                  <Label fx:id="lbErrorApMaterno" text="Solo caracteres de a-z" textFill="RED" visible="false" />
               </children>
            </VBox>
            <VBox spacing="2.0" GridPane.columnIndex="2" GridPane.rowIndex="3">
               <children>
                  <Label text="Estado" />
                  <TextField fx:id="tfEstado" editable="false" style="-fx-background-color: #eee;" />
               </children>
            </VBox>
         </children>
      </GridPane>

      <Button layoutX="545.0" layoutY="520.0" mnemonicParsing="false" onAction="#clicGuardar" prefHeight="40.0" prefWidth="150.0" text="Registrar Envío" />
   </children>
</AnchorPane>