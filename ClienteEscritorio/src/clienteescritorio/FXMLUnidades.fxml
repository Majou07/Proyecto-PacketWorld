<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="700.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="clienteescritorio.FXMLUnidadesController">
   <children>
      <Label layoutX="30.0" layoutY="30.0" text="TABLA DE UNIDADES">
         <font><Font size="24.0" /></font>
      </Label>
      <TextField fx:id="tfBusqueda" layoutX="30.0" layoutY="80.0" prefWidth="400.0" promptText="Buscar por VIN, Marca o NII" />
      
      <TableView fx:id="tvUnidades" layoutX="30.0" layoutY="130.0" prefHeight="500.0" prefWidth="600.0">
        <columns>
          <TableColumn fx:id="colMarca" prefWidth="100.0" text="Marca" />
          <TableColumn fx:id="colModelo" prefWidth="100.0" text="Modelo" />
          <TableColumn fx:id="colAnio" prefWidth="80.0" text="Año" />
          <TableColumn fx:id="colVin" prefWidth="150.0" text="VIN" />
          <TableColumn fx:id="colNii" prefWidth="100.0" text="NII" />
          <TableColumn fx:id="colTipo" prefWidth="70.0" text="Tipo" />
        </columns>
      </TableView>
      
      <VBox layoutX="650.0" layoutY="130.0" spacing="20.0">
         <children>
            <Button mnemonicParsing="false" onAction="#btnRegistrar" prefWidth="120.0" text="Registrar" />
            <Button mnemonicParsing="false" onAction="#btnEditar" prefWidth="120.0" text="Editar" />
            <Button mnemonicParsing="false" onAction="#btnDarBaja" prefWidth="120.0" text="Dar de baja" />
         </children>
      </VBox>
   </children>
</AnchorPane>