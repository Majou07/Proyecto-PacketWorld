<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="480.0" prefWidth="650.0"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="clienteescritorio.FXMLFormularioClienteController">

   <children>

      <Label fx:id="lbTitulo"
             layoutX="30.0"
             layoutY="20.0"
             text="Registro de Cliente">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>

      <GridPane hgap="15.0" layoutX="30.0" layoutY="70.0" prefWidth="590.0" vgap="15.0">

        <columnConstraints>
          <ColumnConstraints prefWidth="185.0" />
          <ColumnConstraints prefWidth="185.0" />
          <ColumnConstraints prefWidth="185.0" />
        </columnConstraints>

        <children>

           <!-- NOMBRE -->
           <VBox spacing="2.0" GridPane.rowIndex="0" GridPane.columnIndex="0">
              <children>
                 <Label text="Nombre *" />
                 <TextField fx:id="tfNombre" />
                 <Label fx:id="lbErrorNombre"
                        text="Campo obligatorio"
                        textFill="RED"
                        visible="false"
                        managed="false"/>
              </children>
           </VBox>

           <!-- APELLIDO PATERNO -->
           <VBox spacing="2.0" GridPane.rowIndex="0" GridPane.columnIndex="1">
              <children>
                 <Label text="Apellido Paterno *" />
                 <TextField fx:id="tfPaterno" />
                 <Label fx:id="lbErrorPaterno"
                        text="Campo obligatorio"
                        textFill="RED"
                        visible="false"
                        managed="false"/>
              </children>
           </VBox>

           <!-- APELLIDO MATERNO -->
           <VBox spacing="2.0" GridPane.rowIndex="0" GridPane.columnIndex="2">
              <children>
                 <Label text="Apellido Materno" />
                 <TextField fx:id="tfMaterno" />
              </children>
           </VBox>

           <!-- CALLE -->
           <VBox spacing="2.0" GridPane.rowIndex="1" GridPane.columnIndex="0">
              <children>
                 <Label text="Calle *" />
                 <TextField fx:id="tfCalle" />
                 <Label fx:id="lbErrorCalle"
                        text="Campo obligatorio"
                        textFill="RED"
                        visible="false"
                        managed="false"/>
              </children>
           </VBox>

           <!-- NUMERO -->
           <VBox spacing="2.0" GridPane.rowIndex="1" GridPane.columnIndex="1">
              <children>
                 <Label text="Número *" />
                 <TextField fx:id="tfNumero" />
                 <Label fx:id="lbErrorNumero"
                        text="Campo obligatorio"
                        textFill="RED"
                        visible="false"
                        managed="false"/>
              </children>
           </VBox>

           <!-- COLONIA -->
           <VBox spacing="2.0" GridPane.rowIndex="1" GridPane.columnIndex="2">
              <children>
                 <Label text="Colonia *" />
                 <ComboBox fx:id="cbColonia"
                           prefWidth="185.0"
                           promptText="Selecciona colonia" />
                 <Label fx:id="lbErrorColonia"
                        text="Selecciona una colonia"
                        textFill="RED"
                        visible="false"
                        managed="false"/>
              </children>
           </VBox>

           <!-- TELEFONO -->
           <VBox spacing="2.0" GridPane.rowIndex="2" GridPane.columnIndex="0">
              <children>
                 <Label text="Teléfono *" />
                 <TextField fx:id="tfTelefono" promptText="10 dígitos" />
                 <Label fx:id="lbErrorTelefono"
                        text="Formato inválido"
                        textFill="RED"
                        visible="false"
                        managed="false"/>
              </children>
           </VBox>

           <!-- CP -->
           <VBox spacing="2.0" GridPane.rowIndex="2" GridPane.columnIndex="1">
              <children>
                 <Label text="C.P. *" />
                 <TextField fx:id="tfCP" promptText="5 dígitos" />
                 <Label fx:id="lbErrorCP"
                        text="CP no encontrado"
                        textFill="RED"
                        visible="false"
                        managed="false"/>
              </children>
           </VBox>

           <!-- CORREO -->
           <VBox spacing="2.0" GridPane.rowIndex="2" GridPane.columnIndex="2">
              <children>
                 <Label text="Correo Electrónico *" />
                 <TextField fx:id="tfCorreo" promptText="ejemplo@dominio.com" />
                 <Label fx:id="lbErrorCorreo"
                        text="Formato inválido"
                        textFill="RED"
                        visible="false"
                        managed="false"/>
              </children>
           </VBox>

        </children>
      </GridPane>

      <Button layoutX="520.0" layoutY="410.0"
              onAction="#clicGuardar"
              prefWidth="100.0"
              text="Guardar" />

      <Button layoutX="405.0" layoutY="410.0"
              onAction="#clicCancelar"
              prefWidth="100.0"
              text="Cancelar" />

   </children>
</AnchorPane>