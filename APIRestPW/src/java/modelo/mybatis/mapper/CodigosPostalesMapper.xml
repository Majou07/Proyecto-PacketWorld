<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="catalogoCP">

  <!-- Buscar colonias, ciudad y estado por código postal -->
  <select id="buscar-por-cp" parameterType="string" resultType="pojo.CatalogoCP">
    SELECT
      codigo_postal AS codigoPostal,
      colonia,
      municipio,
      ciudad,
      estado
    FROM catalogo_codigo_postal
    WHERE codigo_postal = #{codigoPostal}
  </select>

</mapper>
